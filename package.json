{
  "name": "osm-charge-review",
  "version": "0.1.0",
  "description": "Human-in-the-loop review tool for conflating charging-station data with OpenStreetMap",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari major versions",
    "not dead"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:https": "HTTPS=1 vite",
    "preview:https": "HTTPS=1 vite preview --host 127.0.0.1",
    "cert": "mkdir -p .cert && openssl req -x509 -newkey rsa:2048 -nodes -days 825 -subj /CN=localhost -addext subjectAltName=DNS:localhost,IP:127.0.0.1 -keyout .cert/key.pem -out .cert/cert.pem",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build",
    "gen": "tsx scripts/gen-schema-code.ts && prettier --write src/format/generated",
    "gen:check": "pnpm gen && git diff --exit-code -- src/format/generated"
  },
  "dependencies": {
    "@tanstack/svelte-virtual": "^3.13.39",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "osm-auth": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
